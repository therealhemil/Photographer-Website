<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>portfolio</title>
    <link rel="stylesheet" href="/css/style.css">
    <!-- Responsive css -->
    <link rel="stylesheet" media="screen and (max-width:1100px)" href="/css/reponsive-style.css">
    <script src="/js/script.js"></script>
</head>

<body>

    <!-- Header Here-->
     <%- include("../partials/header") %>


    <section>
        <h1 class="fade-in portfolio-name">Portfolio</h1>

        <!-- Event Images -->
        <div class="event-container portfolio-container">
            <h1>Event Images:</h1>
            <div class="event-box landscape">
                <div class="grid">
                    <div class="img-box"><img src="/images/Portfolio images/Event Images/1.jpg" loading="lazy"></div>
                    <div class="img-box"><img src="/images/Portfolio images/Event Images/2.jpg" loading="lazy"></div>
                    <div class="img-box"><img src="/images/Portfolio images/Event Images/3.jpg" loading="lazy"></div>
                    <div class="img-box"><img src="/images/Portfolio images/Event Images/4.jpg" loading="lazy"></div>
                </div>
            </div>
            <div class="explore-more">
                <a href="/portfolio_event_images" class="btn">Explore Images</a>
            </div>
        </div>

        <!-- Wedding Images -->
        <div class="wedding-container portfolio-container">
            <h1>Wedding Images:</h1>
            <div class="wedding-box landscape">
                <div class="grid">
                    <div class="img-box"><img src="/images/Portfolio images/Wedding Images/1.jpg" loading="lazy">
                    </div>
                    <div class="img-box"><img src="/images/Portfolio images/Wedding Images/2.jpg" loading="lazy">
                    </div>
                    <div class="img-box"><img src="/images/Portfolio images/Wedding Images/3.jpg" loading="lazy">
                    </div>
                    <div class="img-box"><img src="/images/Portfolio images/Wedding Images/4.jpg" loading="lazy">
                    </div>
                </div>
            </div>
            <div class="explore-more">
                <a href="/portfolio_wedding_images" class="btn">Explore Images</a>
            </div>
        </div>


        <!-- Animal Images -->
        <div class="animal-container portfolio-container">
            <h1>Animal Images:</h1>
            <div class="animal-box landscape">
                <div class="grid">
                    <div class="img-box"><img src="images/Portfolio images/Animal Images/1.jpg" loading="lazy"></div>
                    <div class="img-box"><img src="/images/Portfolio images/Animal Images/2.jpg" loading="lazy"></div>
                    <div class="img-box"><img src="/images/Portfolio images/Animal Images/3.jpg" loading="lazy"></div>
                    <div class="img-box"><img src="/images/Portfolio images/Animal Images/4.jpg" loading="lazy"></div>
                </div>
            </div>
            <div class="explore-more">
                <a href="/portfolio_animal_images" class="btn">Explore Images</a>
            </div>
        </div>


        <!-- Corporate Events -->
        <div class="corporate-event-container portfolio-container">
            <h1>Corporate Events:</h1>
            <div class="corporate-event-box landscape">
                <div class="grid">
                    <div class="img-box"><img src="/images/Portfolio images/Corporate events/1.jpg" loading="lazy">
                    </div>
                    <div class="img-box"><img src="/images/Portfolio images/Corporate events/2.jpg" loading="lazy">
                    </div>
                    <div class="img-box"><img src="/images/Portfolio images/Corporate events/3.jpg" loading="lazy">
                    </div>
                    <div class="img-box"><img src="/images/Portfolio images/Corporate events/4.jpg" loading="lazy">
                    </div>
                </div>
            </div>
            <div class="explore-more">
                <a href="/portfolio_corporate_events" class="btn">Explore Images</a>
            </div>
        </div>


    </section>

    <!-- Full screen image-->
    <div id="lightbox">
        <span id="closeBtn">&times;</span>
        <img id="lightbox-img">
    </div>


