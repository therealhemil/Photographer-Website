<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>portfolio</title>
    <link rel="stylesheet" href="/css/style.css">
    <!-- Responsive css -->
    <link rel="stylesheet" media="screen and (max-width:1100px)" href="/css/reponsive-style.css">
    <script src="/js/script.js"></script>
</head>

<body>

    <!-- Header Here-->
    <%- include("../partials/header") %>

        <section>
            <h1 class="fade-in portfolio-name">Portfolio</h1>

            <% portfolios.forEach(p=> { %>
                <div class="portfolio-container">
                    <h1>
                        <%= p.title %>:
                    </h1>

                    <div class="landscape">
                        <div class="grid">

                            <% if (p.images && p.images.length> 0) { %>

                                <% p.images.slice(0, 4).forEach(img=> { %>
                                    <div class="img-box">
                                        <img src="<%= img %>" loading="lazy">
                                    </div>
                                    <% })%>

                                        <% } else { %>

                                            <!-- NO IMAGE CASE -->
                                            <div class="no-image">
                                                <p>No Images Available</p>
                                            </div>

                                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="explore-more">
                    <a href="/portfolio/<%= p.id %>" class="btn">Explore Images</a>
                </div>
                </div>
                <% }) %>

        </section>

        <!-- Full screen image-->
        <div id="lightbox">
            <span id="closeBtn">&times;</span>
            <img id="lightbox-img">
        </div>


