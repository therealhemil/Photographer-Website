<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sam's Photography</title>
    <link rel="stylesheet" href="/css/style.css">
    <!-- Responsive css -->
    <link rel="stylesheet" media="screen and (max-width:1100px)" href="/css/reponsive-style.css">
    <script src="/js/script.js"></script>

</head>

<body>

    <!-- Header Here-->
     <%- include("../partials/header") %>


    <!-- Banner Image and details -->
    <section class="banner">
        <h1 class="fade-in">Capturing Moments That Matter</h1>
    </section>


    <!-- Hero section -->
    <!-- Experience Details -->
    <section class="hero fade-up">
        <h2>8+ Years Experience</h2>
        <p>I am a professional photographer dedicated to capturing real emotions and unforgettable moments. From
            weddings to wildlife, my goal is to create images that speak beyond words.I am a passionate photographer
            capturing timeless memories through creative storytelling. My expertise spans
            weddings, wildlife, and events photography.</p><br>
        <a href="/about_us" class="btn">Learn More</a>
    </section>



    <!-- Horizontal Images container  -->
    <section class="banner-images">
        <div class="horizontal-images" id="slider">

            <img src="/images/banner images/1.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/2.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/3.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/4.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/5.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/6.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/7.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/8.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/9.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/10.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/5.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/6.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/7.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/8.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/9.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/10.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/1.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/2.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/3.jpg" class="randomImage" alt="A Random Images" loading="lazy">
            <img src="/images/banner images/4.jpg" class="randomImage" alt="A Random Images" loading="lazy">
        </div>
        <div class="banner-controls">
            <div id="prevBtn" class="prevbtn banner-btn">
                &laquo;
            </div>
            <div id="nextBtn" class="nextbtn banner-btn">
                &raquo;
            </div>
        </div>
    </section>


    <!-- Portfolio Section -->
    <section class="portfolio">
        <h1 class="fade-in portfolio-name">Portfolio</h1>
        <div class="grid">
            <div class="img-box">
                <img src="/images/banner images/3.jpg">
                <!-- overlay text in image -->
                <div class="overlay-text">Event Images</div>
            </div>
            <div class="img-box">
                <img src="/images/banner images/9.jpg">
                <!-- overlay text in image -->
                <div class="overlay-text">Wedding Images</div>
            </div>
            <div class="img-box"><img src="/images/banner images/1.jpg">
                <!-- overlay text in image -->
                <div class="overlay-text">Animal Images</div>
            </div>
            <div class="img-box"><img src="/images/banner images/5.jpg">
                <!-- overlay text in image -->
                <div class="overlay-text">Corporate Event</div>
            </div>
        </div>
        <a href="/portfolio" class="btn">Explore Portfolio</a>
    </section>


    <!-- Feedback Section -->
    <section class="feedback fade-up">
        <h2>Clients Feedback</h2>

        <div class="feedback-container">
            <!-- User 1 -->
            <div class="users">
                <img src="../images/feedback images/1.jpg" alt="User 1">
                <h3>Sandra Warner</h3>
                <div class="comment">
                    I have contracted Jonathan for 3 family events and have always been 100% satisfied. He has been
                    available and responsive anytime I have had questions and has always had the patience to help
                    me.
                </div>
            </div>

            <!-- user 2 -->
            <div class="users">
                <img src="../images/feedback images/2.jpg" alt="User 2">
                <h3>Kelly McMillan</h3>
                <div class="comment">
                    I absolutely loved my session and all of the pictures that came from it. You have a clear
                    passion
                    for what you do and it shows through your work! I highly recommend J. Davis for any photography
                    needs!
                </div>
            </div>

            <!-- user 3 -->
            <div class="users">
                <img src="../images/feedback images/3.jpg" alt="User 3">
                <h3>Ann Barnett</h3>
                <div class="comment">
                    I was so happy with the pictures Jonathan took. He was very kind and patient with my two-month
                    old
                    and my energetic 6 y.o. children. I will be going to Jonathan from now on!
                </div>
            </div>

            <!-- User 4
            <div class="users">
                <img src="../images/feedback images/1.jpg" alt="User 1">
                <h3>Sandra Warner</h3>
                <div class="comment">
                    I have contracted Jonathan for 3 family events and have always been 100% satisfied. He has been
                    available and responsive anytime I have had questions and has always had the patience to help
                    me.
                </div> -->
        </div>
        </div>
    </section>


    <!-- Full screen image-->
    <div id="lightbox">
        <span id="closeBtn">&times;</span>
        <img id="lightbox-img">
    </div>

    <!-- Footer here-->
    <%- include("../partials/footer")%>

</body>

</html>