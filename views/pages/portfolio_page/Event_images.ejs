<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>portfolio-event-images</title>
    <!-- css file -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- Responsive css -->
    <link rel="stylesheet" media="screen and (max-width:1100px)" href="/css/reponsive-style.css">
    <!-- javascript file -->
    <script src="/js/script.js"></script>

</head>

<body>

    <!-- Header Here-->
    <%- include("./header") %>



        <section class="event-section">
            <h1 class="fade-in portfolio-name">Event Images</h1>
            <div class="landscape">
                <div class="grid">
                    <div class="img-box"><img src="/images/Portfolio images/Event Images/1.jpg" loading="lazy"></div>
                    <div class="img-box"><img src="/images/Portfolio images/Event Images/2.jpg" loading="lazy"></div>
                    <div class="img-box"><img src="/images/Portfolio images/Event Images/3.jpg" loading="lazy"></div>
                    <div class="img-box"><img src="/images/Portfolio images/Event Images/4.jpg" loading="lazy"></div>
                    <div class="img-box"><img src="/images/Portfolio images/Event Images/5.jpg" loading="lazy"></div>
                    <div class="img-box"><img src="/images/Portfolio images/Event Images/6.jpg" loading="lazy"></div>
                    <div class="img-box"><img src="/images/Portfolio images/Event Images/7.jpg" loading="lazy"></div>
                    <div class="img-box"><img src="/images/Portfolio images/Event Images/8.jpg" loading="lazy"></div>
                    <div class="img-box"><img src="/images/Portfolio images/Event Images/9.jpg" loading="lazy"></div>
                    <div class="img-box"><img src="/images/Portfolio images/Event Images/10.jpg" loading="lazy"></div>
                    <div class="img-box"><img src="/images/Portfolio images/Event Images/11.jpg" loading="lazy"></div>
                    <div class="img-box"><img src="/images/Portfolio images/Event Images/12.jpg" loading="lazy"></div>
                </div>
            </div>
        </section>

        <!-- Full screen image-->
        <div id="lightbox">
            <span id="closeBtn">&times;</span>
            <img id="lightbox-img">
        </div>



        <!-- footer here-->
        <%- include("./footer") %>

</body>

</html>