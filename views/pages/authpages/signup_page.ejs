<title>Signup | Sam's Photography</title>

<!-- link css file -->
<link rel="stylesheet" href="/css/auth.css">

<!-- link javascriot file -->
<script src="/js/script.js"></script>
<script src="/js/auth.js"></script>


<!-- Sign Up Page -->
<div class="auth-container">

    <div class="auth-box signup-box">
        <h2>Create Account</h2>
        <p>Join Sam's Photography today</p>

        <form class="signup-form">
            <!-- Name -->
            <div class="row">
                <input type="text" name="first_name" placeholder="First Name" required>
                <input type="text" name="last_name" placeholder="Last Name" required>
            </div>

            <!-- Email -->
            <input type="email" name="email" placeholder="Email Address" required>

            <!-- Password -->
            <input type="password" name="password" placeholder="Create Password" minlength="8" required>
            <input type="password" name="confirm_password" placeholder="Repeat Password" required>

            <!-- Gender Dropdown -->
            <select name="gender" required>
                <option value="">Select Gender</option>
                <option value="male">Male</option>
                <option value="female">Female</option>
                <option value="other">Other</option>
            </select>

            <!-- DOB -->
            <!-- <input type="date" name="dob" required> -->
            <p class="signup-message"> </p>


            <button type="submit">Sign Up</button>
        </form>


        <p class="switch">
            Already have an account? <a href="/login">Login</a>
        </p>
    </div>

</div>