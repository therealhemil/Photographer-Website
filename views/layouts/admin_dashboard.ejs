<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin DashBoard | Sam's Photography</title>

    <!-- link css -->
    <link rel="stylesheet" href="/css/admin_dashboard.css">

    <!-- Sidebar Css -->
    <!-- <link rel="stylesheet" href="/css/sidebar.css"> -->

    <!-- link javascript -->
    <script src="/js/admin_dashboard.js"></script>

</head>

<body>

    <div class="layout">

        <!-- Admin Dashboard Sidebar -->
        <%- include("../partials/adminDashboard_sidebar") %>
    
        <main class="admin-shell">
            <section class="admin-hero">
                <div>
                    <p class="eyebrow">Admin Dashboard</p>
                    <h1>Manage registered users with a cleaner workflow.</h1>
                    <p class="hero-copy">Review account details, update profile information, and remove outdated users from
                        one modern control panel.</p>
                    </div>
                    <a class="hero-link" href="/">Back to website</a>
                </section>
                
                
                <section class="stats-grid">
                    <article class="stat-card">
                        <span>Total Users</span>
                        <strong data-stat="total">
                            <%= stats.totalUsers %>
                        </strong>
                    </article>
                    <article class="stat-card">
                        <span>Male</span>
                        <strong data-stat="male">
                            <%= stats.maleUsers %>
                        </strong>
                    </article>
                    <article class="stat-card">
                        <span>Female</span>
                        <strong data-stat="female">
                            <%= stats.femaleUsers %>
                        </strong>
                    </article>
                    <article class="stat-card">
                        <span>Other</span>
                        <strong data-stat="other">
                            <%= stats.otherUsers %>
                        </strong>
                    </article>
                </section>
                
                <section class="admin-grid">
                    <div class="panel panel-table">
                        <div class="panel-head">
                            <div>
                                <h2>User Directory</h2>
                                <p>Search, review, and select a user to edit.</p>
                            </div>
                            <input type="search" id="userSearch" placeholder="Search by name, email, or gender">
                        </div>
                        
                        <p class="admin-message" id="adminMessage"></p>
                        
                        <div class="table-wrap">
                            <table class="users-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>First Name</th>
                                <th>Last Name</th>
                                <th>Email</th>
                                <th>Gender</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="usersTableBody">
                            <% if (users.length) { %>
                                <% users.forEach((user)=> { %>
                                    <tr data-user-id="<%= user.id %>"
                                        data-first-name="<%= user.first_name || '' %>"
                                        data-last-name="<%= user.last_name || '' %>"
                                        data-email="<%= user.email || '' %>" data-gender="<%= user.gender || '' %>">
                                        <td>
                                            <%= user.id %>
                                        </td>
                                        <td data-field="first_name">
                                            <%= user.first_name || '-' %>
                                        </td>
                                        <td data-field="last_name">
                                            <%= user.last_name || '-' %>
                                        </td>
                                        <td data-field="email">
                                            <%= user.email || '-' %>
                                        </td>
                                        <td data-field="gender">
                                            <%= user.gender || '-' %>
                                        </td>
                                        <td>
                                            <div class="table-actions">
                                                <button class="edit-btn" type="button">Modify</button>
                                                <button class="delete-btn" type="button">Delete</button>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                                    <% } else { %>
                                            <tr class="empty-row">
                                                <td colspan="6">No users found in the database yet.</td>
                                            </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                </div>
            </div>
            <aside class="panel panel-form">
                <div class="panel-head vertical">
                    <div>
                        <h2>Modify User</h2>
                        <p>Choose a user from the table to update their account details.</p>
                    </div>
                    <span class="selected-user" id="selectedUserBadge">No user selected</span>
                </div>
                
                <form id="adminUserForm">
                    <input type="hidden" name="id" id="userId">
                    
                    <label for="first_name">First Name</label>
                    <input type="text" id="first_name" name="first_name" placeholder="First Name" required>
                    
                    <label for="last_name">Last Name</label>
                    <input type="text" id="last_name" name="last_name" placeholder="Last Name" required>
                    
                    <!-- <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" placeholder="Email Address" required> -->
                    
                    <label for="gender">Gender</label>
                    <select id="gender" class="gender-toggleDown" name="gender" required>
                        <option value="">Select gender</option>
                        <option value="male">Male</option>
                        <option value="female">Female</option>
                        <option value="other">Other</option>
                    </select>
                    
                    <div class="form-actions">
                        <button type="submit" class="primary-btn">Save Changes</button>
                        <button type="button" class="secondary-btn" id="clearSelection">Clear</button>
                    </div>
                </form>
            </aside>
        </section>
    </main>
</div>
    

</body>

</html>