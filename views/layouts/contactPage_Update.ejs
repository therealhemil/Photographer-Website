<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Page Detail Update</title>

    <!-- link css -->
    <link rel="stylesheet" href="/css/admin_contactPage_update.css">

    <script src="/js/contactPageUpdate.js"></script>

</head>

<body>
    <div class="layouts">

        <%- include("../partials/adminDashboard_sidebar") %>

            <form id="contactPage_updateForm">

                <label>Contact Address</label>
                <input type="text" id="address" name="address" placeholder="Update Contact Update" required>

                <label>Contact Phone Number</label>
                <input type="number" id="phone_number" name="phone_number" placeholder="Update Contact Phone Number"
                    required>

                <label>Contact Email Address</label>
                <input type="email" id="email" name="email" placeholder="Update Contact Email Address" required>

                <button type="submit">Update</button>

                <p id="message"></p>
            </form>

    </div>
</body>

</html>